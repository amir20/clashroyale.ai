{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDirs": [
      "..",
      "svelte"
    ],
    "allowArbitraryExtensions": true,
    "noEmit": true,
    "incremental": false,
    "tsBuildInfoFile": "tsbuildinfo.json"
  },
  "files": [
    "../node_modules/svelte-check/dist/src/svelte-shims-v4.d.ts",
    "../node_modules/svelte/svelte-html.d.ts"
  ],
  "include": [
    "../src/**/*",
    "svelte/src/**/*"
  ],
  "exclude": [
    "../src/App.svelte",
    "../src/lib/CardTile.svelte",
    "../src/lib/Compare.svelte",
    "../src/lib/Ask.svelte",
    "../src/lib/Rook.svelte",
    "../src/lib/Answer.svelte"
  ]
}