# Clash Royale API token(s) from https://developer.clashroyale.com (each must whitelist your public IP).
# Several keys, comma-separated, crawl proportionally faster: CR_API_TOKEN=key1,key2,key3
CR_API_TOKEN=

# Your player tag (used as the default "me" in CLI/MCP and always crawled)
CR_MY_TAG=#YOURTAG

# Optional: use the RoyaleAPI proxy if your IP changes (whitelist 45.79.218.79 on your key instead)
# CR_API_BASE=https://proxy.royaleapi.dev/v1

# Optional: database location (default: ./data/clash.db)
# CR_DB_PATH=
